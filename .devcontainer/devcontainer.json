{
    "name": "Kleinanzeigen Crawler",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspaces/kleinanzeigen-crawler",
    "remoteUser": "vscode",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "dotnet.defaultSolution": "KleinanzeigenCrawler.sln",
                "editor.formatOnSave": true,
                "files.exclude": {
                    "**/bin": true,
                    "**/obj": true
                }
            }
        }
    },

    "forwardPorts": [9090, "redis:6379"],
    "portsAttributes": {
        "9090": {"label": "Bot Metrics"},
        "redis:6379": {"label": "Redis"}
    },

    "postCreateCommand": "dotnet restore"
}
