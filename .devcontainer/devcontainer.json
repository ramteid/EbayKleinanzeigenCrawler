{
    "name": "Kleinanzeigen Crawler",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "bot",
    "workspaceFolder": "/app",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "dotnet.defaultSolution": "KleinanzeigenCrawler.sln",
                "omnisharp.useModernNet": true,
                "editor.formatOnSave": true,
                "files.exclude": {
                    "**/bin": true,
                    "**/obj": true
                }
            }
        }
    },
    
    "forwardPorts": [9090, 9091, 3000, 6379, 9093],
    "portsAttributes": {
        "9090": {"label": "Bot Metrics"},
        "9091": {"label": "Prometheus"},
        "3000": {"label": "Grafana"},
        "6379": {"label": "Redis"},
        "9093": {"label": "Alertmanager"}
    },
    
    "postCreateCommand": "dotnet restore",
    "remoteUser": "root"
}
