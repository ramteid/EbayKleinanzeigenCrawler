# Messengers - configure at least one. Telegram and Signal can run at the same time.
# Telegram: bot token from @BotFather. The crawler disables Telegram when it is empty.
# docker-compose also uses this token to deliver the monitoring alerts (see below), so set it there.
TELEGRAM_BOT_TOKEN=

# Signal: dedicated number of the bot in international format (see README, section Signal).
# Also set COMPOSE_PROFILES=signal to start the signal-api container.
# SIGNAL_NUMBER=+491701234567
# SIGNAL_API_URL=http://signal-api:8080
# COMPOSE_PROFILES=signal

# Optional - User Registration Control
# Set to false to prevent new users from using the bot (applies to all messengers)
ALLOW_NEW_USERS=true

# Optional - Monitoring
ENABLE_PROMETHEUS=true

# Required by docker-compose - Grafana admin password
GRAFANA_PASSWORD=choose_a_strong_password

# Required by docker-compose - Telegram chat that receives the monitoring alerts.
# The alerts are sent by the bot of TELEGRAM_BOT_TOKEN, so that chat must have started a conversation with the bot.
ALERT_TELEGRAM_CHAT_ID=your_telegram_chat_id
