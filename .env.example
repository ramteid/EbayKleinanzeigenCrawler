TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional - User Registration Control
# Set to false to prevent new users from using the bot
ALLOW_NEW_USERS=true

# Optional - Monitoring
ENABLE_PROMETHEUS=true

# Required by docker-compose - Grafana admin password
GRAFANA_PASSWORD=choose_a_strong_password

# Required by docker-compose - Telegram chat that receives the monitoring alerts.
# The alerts are sent by the bot of TELEGRAM_BOT_TOKEN, so that chat must have started a conversation with the bot.
ALERT_TELEGRAM_CHAT_ID=your_telegram_chat_id
